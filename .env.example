# Copy to .env and fill in. Never commit .env.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when a model is busy or out of free requests (empty = no fallback)
# GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest,gemini-3.5-flash-lite,gemini-flash-lite-latest
# Free key (1,000 credits/month): https://app.tavily.com
TAVILY_API_KEY=
# Comma-separated email domains of your own company (attendees on these are internal).
OWN_COMPANY_DOMAINS=lumora-analytics.com

# Optional overrides (mainly for tests / reproducible runs)
# MEETING_PREP_TODAY=2026-10-06
# MEETING_PREP_DATA_DIR=./data
# MEETING_PREP_ATTACHMENTS_DIR=./data/attachments
# MEETING_PREP_LIVE=1   # enables the live smoke test (tests/test_live.py), which calls real Gemini
